EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/v1

# Clave de Google Maps para el build Android: ver docs/verification.md §Feature 52; la .env real no se commitea.
GOOGLE_MAPS_API_KEY_ANDROID=

# Host pelado del App Link de reset, sin esquema ni path. El dominio real
# vive solo en este .env ignorado; ver docs/verification.md §Feature 59.
RESET_LINK_HOST=
