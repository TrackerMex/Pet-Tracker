{
  "permissions": {
    "allow": [
      "Agent",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git push:*)",
      "Bash(pnpm:*)",
      "Bash(./init.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/alex/AppData/Local/Programs/Python/Python314/Scripts/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/alex/AppData/Local/Programs/Python/Python314/Scripts/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}
